<div class="section-header">
  <h1 class="page-title" style="margin-bottom:0">Transaction History</h1>
  <span class="balance-badge" style="font-size:13px; padding:6px 14px">Balance: <%= current_user.balance %> credits</span>
</div>

<% if @transactions.empty? %>
  <div class="card" style="text-align:center; padding:40px; color:var(--gray-400)">No transactions yet.</div>
<% else %>
  <div class="table-card">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>From</th>
          <th>To</th>
          <th>Credits</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% @transactions.each do |txn| %>
          <tr>
            <td><%= txn.created_at.strftime("%Y-%m-%d") %></td>
            <td>
              <span class="badge bg-<%= txn.amount.positive? ? 'success' : 'danger' %>">
                <%= txn.amount.positive? ? 'Earned' : 'Spent' %>
              </span>
            </td>
            <td><%= txn.service_request&.requester&.name || "—" %></td>
            <td><%= txn.service_request&.provider&.name || "—" %></td>
            <td style="font-weight:600; color:<%= txn.amount.positive? ? 'var(--success)' : 'var(--danger)' %>">
              <%= txn.amount.positive? ? "+#{txn.amount}" : txn.amount %>
            </td>
            <td><%= txn.description %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
