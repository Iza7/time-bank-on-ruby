<h1 class="page-title">Admin — Users</h1>

<div class="table-card">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Balance</th>
        <th>Joined</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.id %></td>
          <td><strong><%= user.name %></strong></td>
          <td><%= user.email %></td>
          <td>
            <span class="badge bg-<%= user.admin? ? 'warning' : 'secondary' %>">
              <%= user.admin? ? 'admin' : 'user' %>
            </span>
          </td>
          <td><%= user.balance %></td>
          <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
          <td class="d-flex gap-2">
            <%= link_to "View", admin_user_path(user), class: "btn btn-outline-primary btn-sm" %>
            <%= button_to user.active? ? "Deactivate" : "Activate",
                toggle_active_admin_user_path(user),
                method: :patch,
                class: "btn btn-sm #{user.active? ? 'btn-outline-danger' : 'btn-success'}" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
