<h2>Admin — Users</h2>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
      <th>Balance</th>
      <th>Joined</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td><%= user.balance %></td>
        <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
        <td><a href="/admin/users/<%= user.id %>">View</a></td>
      </tr>
    <% end %>
  </tbody>
</table>
