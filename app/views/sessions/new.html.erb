<div class="auth-wrapper">
  <div class="auth-card">
    <h2>Welcome Back!</h2>
    <p class="auth-subtitle">Login to your account</p>

    <form action="/login" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <div class="mb-2">
        <label>Email</label>
        <input class="form-control" type="email" name="email" placeholder="you@example.com">
      </div>
      <div class="mb-3">
        <label>Password</label>
        <input class="form-control" type="password" name="password" placeholder="••••••••">
      </div>

      <button class="btn btn-primary" style="width:100%">Login</button>
    </form>

    <p style="text-align:center; margin-top:16px; font-size:13px; color:var(--gray-500)">
      Don't have an account? <a href="/register" style="color:var(--primary); font-weight:500">Register</a>
    </p>
  </div>
</div>
