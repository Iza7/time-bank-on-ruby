<h1 class="page-title">Buy Time Credits</h1>

<% if params[:success] %>
  <div class="alert alert-success">
    ✅ Payment successful! Credits will be added to your account shortly.
  </div>
<% end %>

<% if params[:cancelled] %>
  <div class="alert alert-danger">
    ❌ Payment cancelled. No charges were made.
  </div>
<% end %>

<p style="color:var(--gray-500); margin-bottom:24px; font-size:14px">
  Choose how many credits you'd like to purchase. 1 credit = €1.00
</p>

<div style="display:grid; grid-template-columns: repeat(3,1fr); gap:16px; margin-bottom:24px">
  <% [[5, 5], [10, 10], [20, 20]].each do |credits, price| %>
    <div class="card" style="text-align:center; padding:32px 20px; transition: box-shadow 0.15s, transform 0.15s" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'; this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow=''; this.style.transform=''">
      <div style="font-size:40px; font-weight:700; color:var(--primary); margin-bottom:4px"><%= credits %></div>
      <div style="font-size:13px; color:var(--gray-400); margin-bottom:16px; text-transform:uppercase; letter-spacing:0.05em">Time Credits</div>
      <div style="font-size:22px; font-weight:600; color:var(--gray-800); margin-bottom:20px">€<%= price %>.00</div>
      <form action="/buy-credits" method="post" data-turbo="false">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="hidden" name="credits" value="<%= credits %>">
        <button class="btn btn-primary" style="width:100%; padding:10px">Buy Now</button>
      </form>
    </div>
  <% end %>
</div>

<div class="card" style="padding:16px 20px; background:var(--gray-50); border-color:var(--gray-200)">
  <p style="font-size:13px; color:var(--gray-500); margin:0">
    🔒 Payments are securely processed by <strong>Stripe</strong>.
    Your card details are never stored on our servers.
    Credits are added automatically after payment confirmation.
  </p>
</div>

<div style="margin-top:16px; padding:12px 16px; background:#fdf6b2; border-radius:8px; border:1px solid #f3d675">
  <p style="font-size:12px; color:#723b13; margin:0">
    <strong>Test mode:</strong> Use card <code>4242 4242 4242 4242</code>, any future date, any CVV.
  </p>
</div>
