<h2>Welcome, <%= current_user.name %></h2>

<div class="card mt-3" style="max-width: 480px;">
  <div class="card-body">
    <p class="mb-1"><strong>Email:</strong> <%= current_user.email %></p>
    <p class="mb-1"><strong>Balance:</strong> <%= current_user.balance %> credit(s)</p>
    <p class="mb-0"><strong>Role:</strong> <%= current_user.role.capitalize %></p>
  </div>
</div>

<a href="/profile/edit" class="btn btn-primary mt-3">Edit Profile</a>
