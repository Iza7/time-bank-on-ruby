<h2>Register</h2>

<% if @user.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="/users" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

  <input class="form-control mb-2" type="text" name="user[name]" placeholder="Name" value="<%= @user.name %>">
  <input class="form-control mb-2" type="email" name="user[email]" placeholder="Email" value="<%= @user.email %>">
  <input class="form-control mb-2" type="password" name="user[password]" placeholder="Password (min 8 characters)">

  <button class="btn btn-primary">Register</button>
</form>

<a href="/login">Already have an account?</a>
